# Chat model (server-side only — never expose these to the browser)
# Groq is preferred when GROQ_API_KEY is set. Keep keys out of source control.
# https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
# Allowed ids: openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_MODEL="qwen/qwen3.8-27b"

# OpenAI-compatible fallback. Not needed when GROQ_API_KEY is set.
OPENAI_API_KEY=""

# Optional: model id. Defaults to gpt-4o. Use a stronger model for complex
# reasoning, e.g. gpt-5.2, claude-* via a gateway, or a local model id.
OPENAI_MODEL=""

# Optional: any OpenAI-compatible endpoint.
# OpenRouter:   https://openrouter.ai/api/v1
# Ollama:       http://localhost:11434/v1
# LM Studio:    http://localhost:1234/v1
# vLLM:         http://localhost:8000/v1
OPENAI_BASE_URL=""

# LaTeX compilation service
LATEX_API_URL=""

# Lean Lake bridge (served by latex-api; run the web app locally)
# Defaults to LATEX_API_URL when empty.
LEAN_API_URL=""
# Optional shared secret; must match the latex-api environment.
LEAN_BRIDGE_TOKEN=""

# Developer control panel (development only). Set both to preview a
# production build with the panel enabled.
NEXT_PUBLIC_DEV_PANEL=""
DEV_PANEL_ENABLED=""

# Literature search
# Springer Nature API keys (server-side only). Create keys at
# https://dev.springernature.com/
SPRINGER_META_API_KEY=""
SPRINGER_OPENACCESS_API_KEY=""

# Zotero web API (server-side key preferred). Keys are never exposed to the
# browser. Set ZOTERO_LIBRARY_TYPE=groups and a group id for a group library.
ZOTERO_API_KEY=""
ZOTERO_LIBRARY_TYPE="users"
ZOTERO_LIBRARY_ID="0"

# Optional: sync server WebSocket base, e.g. ws://localhost:3001/sync
NEXT_PUBLIC_SYNC_URL=""

# Local Python/R tools for AI-generated TikZ figures. Code runs in a temporary
# directory with a timeout; macOS also uses sandbox-exec to deny network and
# home-directory reads. Set to "false" to disable these tools.
ENABLE_LOCAL_CODE_EXECUTION="true"
# Non-macOS only: permit code execution without an OS sandbox. Keep false unless
# you explicitly trust AI-generated local code; there is no network isolation.
ALLOW_UNSANDBOXED_CODE_EXECUTION="false"
# Optional interpreter paths. Empty values use python3 and Rscript.
PYTHON_BIN=""
R_BIN=""

# Optional rate limiting (Upstash Redis)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
